# Optional Firebase web-project overrides. Blank values use the public project
# configuration in src/config/firebaseProject.json, as on the deployed app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Gemini/Groq provider keys belong in the signed-in AI Settings UI, not here.
# VITE_* values are public browser configuration; never put secrets in them.
# Optional: enable App AI only after the Worker Free rollout is verified.
VITE_APP_AI_URL=
