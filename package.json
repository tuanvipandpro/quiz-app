{
  "name": "quiz-app",
  "private": true,
  "version": "19.2.0",
  "type": "module",
  "homepage": "https://tuanvipandpro.github.io/quiz-app",
  "description": "A simple quiz application built with React and Ant Design.",
  "author": "Tuanvipandpro",
  "license": "MIT",
  "keywords": [
    "quiz",
    "react",
    "ant-design",
    "vite"
  ],
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "doctor": "node scripts/doctor.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "check:catalog": "node scripts/check-catalog.mjs",
    "check:guides": "node scripts/check-catalog.mjs --strict-guides",
    "check:build": "node scripts/check-build.mjs",
    "verify": "yarn doctor && yarn lint && yarn format:check && yarn test && yarn sdd:validate && yarn check:catalog && yarn build && yarn check:build",
    "verify:all": "yarn verify && yarn test:rules && yarn test:e2e",
    "sdd": "node scripts/openspec.mjs",
    "sdd:validate": "node scripts/openspec.mjs validate --all --strict --no-interactive",
    "sdd:status": "node scripts/openspec.mjs status --change custom-quizzes-42",
    "test:rules": "node scripts/run-firestore-emulator.mjs test",
    "emulators:start": "node scripts/run-firestore-emulator.mjs start",
    "doctor:sdd": "node scripts/run-firestore-emulator.mjs check"
  },
  "devDependencies": {
    "@eslint/js": "10",
    "@firebase/rules-unit-testing": "5.0.0",
    "@fission-ai/openspec": "1.15.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "10",
    "eslint-plugin-react": "7",
    "firebase-tools": "15.34.2",
    "gh-pages": "^6.3.0",
    "globals": "16",
    "prettier": "3.6.2",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "antd": "^5.27.0",
    "firebase": "^12.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "engines": {
    "node": "24.x"
  }
}
